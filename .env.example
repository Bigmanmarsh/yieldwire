# Copy to .env for local runs:  cp .env.example .env
# On GitHub, set these as repo Secrets: Settings → Secrets and variables → Actions
#
# Required for Telegram alerts (create the bot with @BotFather):
TG_BOT_TOKEN=
TG_CHAT_ID=
#
# Optional: free Gemini API key (https://aistudio.google.com) for one-line
# summaries. Without it the agent runs keyless: deterministic template
# messages only. That is a supported mode, not a degraded one — the numbers
# never needed a model.
GEMINI_API_KEY=
#
# Where receipt links point (default shown):
# SITE_BASE=https://bigmanmarsh.github.io/yieldwire
